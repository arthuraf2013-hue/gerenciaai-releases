{
  "name": "gerenciaai-pwa-mobile",
  "private": true,
  "version": "2.0.0",
  "description": "GerenciaAI no celular (PWA): garçom, PDV móvel, consulta remota e vitrine online",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-force-exit \"tests/**/*.test.js\"",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "jsdom": "24.1.3",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=22"
  }
}
