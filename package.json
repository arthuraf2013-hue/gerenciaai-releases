{
  "name": "gerenciaai",
  "version": "0.5.65",
  "description": "GerenciaAI — gerenciamento de estoque com PDV, perfil inicial para farmácias, automações e espaço reservado para funcionalidades de IA",
  "author": "Arthur",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder --publish never",
    "test": "node --test",
    "postinstall": "electron-builder install-app-deps",
    "postversion": "git push && git push --tags"
  },
  "overrides": {
    "uuid": "^14.0.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "firebase": "^11.0.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "serialport": "^12.0.0",
    "xml-crypto": "^6.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@xmldom/xmldom": "^0.9.10",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsbarcode": "^3.11.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.arthur.gerenciaai",
    "compression": "maximum",
    "productName": "GerenciaAI",
    "files": [
      "dist/**",
      "electron/**",
      "!node_modules/**/*.map",
      "!node_modules/firebase/compat/**",
      "!node_modules/firebase/{messaging,storage,remote-config,performance,installations,vertexai,analytics,functions,database,database-compat,storage-compat,messaging-compat,analytics-compat,functions-compat,remote-config-compat,performance-compat,app-check,app-check-compat,ai,data-connect,auth,auth-compat,firestore-compat,app-compat}/**",
      "!node_modules/firebase/firebase-auth*.js",
      "!node_modules/firebase/firebase-auth*.js.map",
      "!node_modules/@firebase/{database,database-compat,storage,storage-compat,ai,messaging,messaging-compat,analytics,analytics-compat,functions,functions-compat,remote-config,remote-config-compat,performance,performance-compat,data-connect,app-check,app-check-compat,installations-compat,auth,auth-compat,auth-types,auth-interop-types,firestore-compat,app-compat}/**",
      "!node_modules/exceljs/dist/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**"
    ],
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "arthuraf2013-hue",
      "repo": "gerenciaai-releases",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GerenciaAI",
      "differentialPackage": false
    }
  }
}
